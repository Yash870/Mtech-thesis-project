-64bit
-sv
-v93
-timescale 1ns/1ps
+bus_conflict_off

# CRITICAL: Allow Read/Write access for TCL (and force commands)
-access +rwc

# MUTE PHYSICAL TIMING CHECKS (Zero-Delay GLS)
-nospecify
+notimingchecks

# X-Pessimism correction for TSMC UDP cells.
# Without this, FFs start at X and X propagates forever through UDP MUX cells.
-xprop F

# TSMC/Standard Cell Defines
+define+TSMC_INITIALIZE_MEM
+define+TSMC_INIT_0
+define+SDFF_INIT_0

# ARM UD model: adds #0.01ns delay on SRAM Q output, preventing startup X propagation.
# Without this, Q_ = combinational RETN_?Q_int:0 sees Q_int=X (set by always@RETN_)
# before first readWrite, allowing X to glitch onto mem_rdata during delta cycles.
+define+ARM_UD_MODEL

# Load the initialization script
-input ../scripts/init.tcl

# File Lists
-f ../sourcecode/dut_src_list_glv.txt
../sourcecode/tb/testbench.v
-top testbench
-exit
