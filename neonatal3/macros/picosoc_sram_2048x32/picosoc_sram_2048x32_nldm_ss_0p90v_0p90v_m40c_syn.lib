  /* operation conditions */
  voltage_map (VDDCE, 0.9);
  voltage_map (VDDPE, 0.9);
  voltage_map (VSSE, 0);
  operating_conditions(ss_0p90v_0p90v_m40c) {
    process      : 1;
    temperature  : -40.000;
    voltage      : 0.900;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ss_0p90v_0p90v_m40c;

